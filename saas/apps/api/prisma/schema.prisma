// Seasonal rental PMS SaaS — Prisma schema
// PostgreSQL · multi-tenant (Organization) · Supabase Auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RoleCode {
  SUPER_ADMIN
  ENTERPRISE
  MANAGER
  RECEPTION
  CLEANING
  MAINTENANCE
  OWNER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  OTHER
}

enum BookingStatus {
  INQUIRY
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  BLOCKED
}

enum BookingChannel {
  AIRBNB
  BOOKING
  VRBO
  EXPEDIA
  GOOGLE
  ABRITEL
  DIRECT
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  STRIPE
  PAYPAL
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum CleaningTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  INSPECTED
  FAILED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED
  CANCELLED
}

enum CheckInStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum CheckOutStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  LATE
  CANCELLED
}

enum InventoryLogType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
  DAMAGE
  LOSS
}

enum MessageChannel {
  AIRBNB
  BOOKING
  EMAIL
  WHATSAPP
  SMS
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum ThreadStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
  SPAM
}

enum PricingRuleType {
  NIGHTLY
  WEEKEND
  SEASON
  EVENT
  MIN
  MAX
  MIN_STAY
  MAX_STAY
  DISCOUNT
  PROMOTION
}

enum AutomationTrigger {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  CHECKIN_DUE
  CHECKOUT_DUE
  CLEANING_COMPLETED
  MAINTENANCE_CREATED
  PAYMENT_RECEIVED
  MESSAGE_RECEIVED
  SCHEDULE
  WEBHOOK
  MANUAL
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  CANCELLED
}

enum ChannelProvider {
  AIRBNB
  BOOKING
  VRBO
  EXPEDIA
  GOOGLE
  ABRITEL
  ICAL
  OTHER
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
  REVOKED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiJobType {
  PRICING_SUGGESTION
  MESSAGE_REPLY
  LISTING_OPTIMIZATION
  REVIEW_SUMMARY
  DEMAND_FORECAST
  OTHER
}

enum CalendarBlockReason {
  OWNER_STAY
  MAINTENANCE
  PREPARATION
  SEASONAL_CLOSE
  MANUAL
  EXTERNAL
  OTHER
}

// ─── Auth & RBAC ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique
  email          String   @unique
  firstName      String?
  lastName       String?
  phone          String?
  avatarUrl      String?
  locale         String   @default("fr")
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      OrganizationMember[]
  employee         Employee?
  ownerProfiles    Owner[]
  auditLogs        AuditLog[]           @relation("AuditActor")
  assignedTickets  MaintenanceTicket[]  @relation("TicketAssignee")
  messagesSent     Message[]            @relation("MessageSender")
  aiJobs           AiJob[]

  @@index([email])
  @@index([supabaseUserId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  legalName   String?
  siret       String?
  vatNumber   String?
  email       String?
  phone       String?
  website     String?
  logoUrl     String?
  timezone    String   @default("Europe/Paris")
  currency    String   @default("EUR")
  locale      String   @default("fr")
  isActive    Boolean  @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members              OrganizationMember[]
  properties           Property[]
  amenities            Amenity[]
  reservations         Reservation[]
  calendarBlocks       CalendarBlock[]
  guests               Guest[]
  owners               Owner[]
  vendors              Vendor[]
  payments             Payment[]
  invoices             Invoice[]
  creditNotes          CreditNote[]
  contracts            Contract[]
  employees            Employee[]
  cleaningTeams        CleaningTeam[]
  cleaningTasks        CleaningTask[]
  maintenanceTickets   MaintenanceTicket[]
  technicians          Technician[]
  checkIns             CheckIn[]
  checkOuts            CheckOut[]
  inventoryItems       InventoryItem[]
  inventoryLogs        InventoryLog[]
  messageThreads       MessageThread[]
  messages             Message[]
  reportSnapshots      ReportSnapshot[]
  settings             OrganizationSettings?
  pricingRules         PricingRule[]
  automationRules      AutomationRule[]
  automationRuns       AutomationRun[]
  channelConnections   ChannelConnection[]
  channelListings      ChannelListing[]
  propertyChannelMaps  PropertyChannelMapping[]
  webhookEvents        WebhookEvent[]
  aiJobs               AiJob[]
  auditLogs            AuditLog[]

  @@index([slug])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  members     OrganizationMember[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MemberStatus @default(INVITED)
  invitedAt      DateTime     @default(now())
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
}

// ─── Property ────────────────────────────────────────────────────────────────

model Property {
  id              String    @id @default(cuid())
  organizationId  String
  ownerId         String?
  name            String
  slug            String?
  description     String?
  propertyType    String?
  // Address
  addressLine1    String?
  addressLine2    String?
  city            String?
  postalCode      String?
  state           String?
  country         String    @default("FR")
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  // Capacity & rooms
  capacity        Int       @default(2)
  bedrooms        Int       @default(1)
  bathrooms       Decimal   @default(1) @db.Decimal(3, 1)
  beds            Int?
  // Pricing defaults
  basePrice       Decimal   @default(0) @db.Decimal(12, 2)
  currency        String    @default("EUR")
  touristTax      Decimal?  @db.Decimal(12, 2)
  touristTaxType  String? // FIXED | PERCENT | PER_PERSON_NIGHT
  deposit         Decimal?  @db.Decimal(12, 2)
  cleaningFee     Decimal?  @db.Decimal(12, 2)
  // Check-in / out
  checkInTime     String    @default("16:00")
  checkOutTime    String    @default("11:00")
  // Rules & guide
  houseRules      String?
  digitalGuide    Json?
  amenitiesNotes  String?
  // Status
  isActive        Boolean   @default(true)
  isPublished     Boolean   @default(false)
  timezone        String?
  externalId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            Owner?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  media            PropertyMedia[]
  amenities        PropertyAmenity[]
  reservations     Reservation[]
  calendarBlocks   CalendarBlock[]
  contracts        Contract[]
  cleaningTasks    CleaningTask[]
  maintenanceTickets MaintenanceTicket[]
  checkIns         CheckIn[]
  checkOuts        CheckOut[]
  inventoryItems   InventoryItem[]
  messageThreads   MessageThread[]
  pricingRules     PricingRule[]
  channelListings  ChannelListing[]
  channelMappings  PropertyChannelMapping[]
  invoices         Invoice[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([ownerId])
  @@index([city])
  @@index([isActive])
  @@index([externalId])
  @@index([latitude, longitude])
}

model PropertyMedia {
  id          String    @id @default(cuid())
  propertyId  String
  type        MediaType @default(PHOTO)
  url         String
  thumbnailUrl String?
  caption     String?
  sortOrder   Int       @default(0)
  isCover     Boolean   @default(false)
  width       Int?
  height      Int?
  durationSec Int?
  mimeType    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, sortOrder])
  @@index([type])
}

model Amenity {
  id             String   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  category       String?
  icon           String?
  isGlobal       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   PropertyAmenity[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
}

model PropertyAmenity {
  id        String   @id @default(cuid())
  propertyId String
  amenityId String
  notes     String?
  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

// ─── CRM: Guest, Owner, Vendor ───────────────────────────────────────────────

model Guest {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  firstName      String?
  lastName       String?
  company        String?
  nationality    String?
  language       String?
  dateOfBirth    DateTime?
  idDocumentType String?
  idDocumentNumber String?
  notes          String?
  tags           String[] @default([])
  externalIds    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  payments       Payment[]
  invoices       Invoice[]
  contracts      Contract[]
  messageThreads MessageThread[]
  checkIns       CheckIn[]
  checkOuts      CheckOut[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([organizationId, email])
}

model Owner {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  email          String?
  phone          String?
  firstName      String?
  lastName       String?
  company        String?
  addressLine1   String?
  city           String?
  postalCode     String?
  country        String?
  bankIban       String?
  taxId          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties   Property[]
  contracts    Contract[]
  payments     Payment[]

  @@index([organizationId])
  @@index([userId])
  @@index([email])
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String? // CLEANING | MAINTENANCE | SUPPLIER | OTHER
  email          String?
  phone          String?
  contactName    String?
  addressLine1   String?
  city           String?
  postalCode     String?
  country        String?
  website        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cleaningTeams      CleaningTeam[]
  technicians        Technician[]
  maintenanceTickets MaintenanceTicket[]
  invoices           Invoice[]

  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

// ─── Reservations & Calendar ─────────────────────────────────────────────────

model Reservation {
  id              String         @id @default(cuid())
  organizationId  String
  propertyId      String
  guestId         String?
  status          BookingStatus  @default(PENDING)
  channel         BookingChannel @default(DIRECT)
  confirmationCode String?
  externalId      String?
  externalIds     Json?
  checkInDate     DateTime       @db.Date
  checkOutDate    DateTime       @db.Date
  adults          Int            @default(1)
  children        Int            @default(0)
  infants         Int            @default(0)
  pets            Int            @default(0)
  // Amounts
  currency        String         @default("EUR")
  nightlyRate     Decimal?       @db.Decimal(12, 2)
  nightsCount     Int?
  subtotal        Decimal?       @db.Decimal(12, 2)
  cleaningFee     Decimal?       @db.Decimal(12, 2)
  touristTax      Decimal?       @db.Decimal(12, 2)
  serviceFee      Decimal?       @db.Decimal(12, 2)
  discount        Decimal?       @db.Decimal(12, 2)
  totalAmount     Decimal?       @db.Decimal(12, 2)
  paidAmount      Decimal?       @db.Decimal(12, 2)
  depositAmount   Decimal?       @db.Decimal(12, 2)
  notes           String?
  guestNotes      String?
  source          String?
  bookedAt        DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest          Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)
  payments       Payment[]
  invoices       Invoice[]
  contracts      Contract[]
  cleaningTasks  CleaningTask[]
  checkIns       CheckIn[]
  checkOuts      CheckOut[]
  messageThreads MessageThread[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([guestId])
  @@index([status])
  @@index([channel])
  @@index([externalId])
  @@index([checkInDate, checkOutDate])
  @@index([propertyId, checkInDate, checkOutDate])
  @@index([organizationId, status])
  @@index([confirmationCode])
}

model CalendarBlock {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  reason         CalendarBlockReason @default(MANUAL)
  notes          String?
  externalId     String?
  source         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
  @@index([startDate, endDate])
  @@index([propertyId, startDate, endDate])
  @@index([externalId])
}

// ─── Payments & Invoicing ────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  reservationId  String?
  guestId        String?
  ownerId        String?
  invoiceId      String?
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(CARD)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("EUR")
  stripePaymentId String?
  externalId     String?
  paidAt         DateTime?
  refundedAt     DateTime?
  refundAmount   Decimal?      @db.Decimal(12, 2)
  description    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  owner        Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reservationId])
  @@index([guestId])
  @@index([invoiceId])
  @@index([status])
  @@index([externalId])
  @@index([stripePaymentId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  reservationId  String?
  guestId        String?
  propertyId     String?
  vendorId       String?
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("EUR")
  issueDate      DateTime      @db.Date
  dueDate        DateTime?     @db.Date
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([reservationId])
  @@index([guestId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CreditNote {
  id             String           @id @default(cuid())
  organizationId String
  invoiceId      String?
  number         String
  status         CreditNoteStatus @default(DRAFT)
  currency       String           @default("EUR")
  amount         Decimal          @db.Decimal(12, 2)
  reason         String?
  issuedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  propertyId     String?
  reservationId  String?
  guestId        String?
  ownerId        String?
  title          String
  status         ContractStatus @default(DRAFT)
  type           String? // OWNER_MGMT | GUEST_RENTAL | VENDOR | OTHER
  content        String?
  documentUrl    String?
  signedAt       DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  externalId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  owner        Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([reservationId])
  @@index([status])
  @@index([externalId])
}

// ─── Staff & Cleaning ────────────────────────────────────────────────────────

model Employee {
  id             String    @id @default(cuid())
  organizationId String
  userId         String    @unique
  jobTitle       String?
  department     String?
  hireDate       DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleaningTeams     CleaningTeamMember[]
  cleaningTasks     CleaningTask[]     @relation("CleaningAssignee")
  checklistItems    CleaningChecklistItem[]
  inventoryLogs     InventoryLog[]

  @@index([organizationId])
  @@index([isActive])
}

model CleaningTeam {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  members      CleaningTeamMember[]
  tasks        CleaningTask[]

  @@index([organizationId])
  @@index([vendorId])
}

model CleaningTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  employeeId String
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  team     CleaningTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

model CleaningTask {
  id              String             @id @default(cuid())
  organizationId  String
  propertyId      String
  reservationId   String?
  teamId          String?
  assigneeId      String?
  status          CleaningTaskStatus @default(PENDING)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMin     Int?
  notes           String?
  checklistTemplate Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation   Reservation?            @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  team          CleaningTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee      Employee?               @relation("CleaningAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklistItems CleaningChecklistItem[]
  photos        CleaningPhoto[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([reservationId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([scheduledAt])
  @@index([organizationId, status])
}

model CleaningChecklistItem {
  id           String   @id @default(cuid())
  taskId       String
  employeeId   String?
  label        String
  isRequired   Boolean  @default(true)
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  sortOrder    Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task     CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([employeeId])
}

model CleaningPhoto {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── Maintenance ─────────────────────────────────────────────────────────────

model Technician {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String?
  name           String
  email          String?
  phone          String?
  specialties    String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tickets      MaintenanceTicket[]

  @@index([organizationId])
  @@index([vendorId])
  @@index([isActive])
}

model MaintenanceTicket {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String
  vendorId       String?
  technicianId   String?
  assigneeUserId String?
  title          String
  description    String?
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  category       String?
  costEstimate   Decimal?            @db.Decimal(12, 2)
  costActual     Decimal?            @db.Decimal(12, 2)
  currency       String              @default("EUR")
  reportedAt     DateTime            @default(now())
  scheduledAt    DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor       Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  technician   Technician?        @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  assigneeUser User?              @relation("TicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  photos       MaintenancePhoto[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([technicianId])
  @@index([assigneeUserId])
  @@index([organizationId, status])
}

model MaintenancePhoto {
  id        String   @id @default(cuid())
  ticketId  String
  url       String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ─── Check-in / Check-out ────────────────────────────────────────────────────

model CheckIn {
  id             String        @id @default(cuid())
  organizationId String
  propertyId     String
  reservationId  String?
  guestId        String?
  status         CheckInStatus @default(SCHEDULED)
  scheduledAt    DateTime?
  completedAt    DateTime?
  method         String? // SELF | KEYBOX | STAFF | REMOTE
  accessCode     String?
  notes          String?
  checklist      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([reservationId])
  @@index([status])
  @@index([scheduledAt])
}

model CheckOut {
  id             String         @id @default(cuid())
  organizationId String
  propertyId     String
  reservationId  String?
  guestId        String?
  status         CheckOutStatus @default(SCHEDULED)
  scheduledAt    DateTime?
  completedAt    DateTime?
  method         String?
  notes          String?
  damages        Json?
  checklist      Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([reservationId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String?
  sku            String?
  name           String
  category       String?
  unit           String   @default("unit")
  quantity       Decimal  @default(0) @db.Decimal(12, 3)
  minQuantity    Decimal? @db.Decimal(12, 3)
  unitCost       Decimal? @db.Decimal(12, 2)
  currency       String   @default("EUR")
  location       String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  logs         InventoryLog[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([sku])
  @@index([category])
}

model InventoryLog {
  id             String           @id @default(cuid())
  organizationId String
  itemId         String
  employeeId     String?
  type           InventoryLogType
  quantityDelta  Decimal          @db.Decimal(12, 3)
  quantityAfter  Decimal?         @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

model MessageThread {
  id             String         @id @default(cuid())
  organizationId String
  propertyId     String?
  reservationId  String?
  guestId        String?
  channel        MessageChannel
  externalId     String?
  subject        String?
  status         ThreadStatus   @default(OPEN)
  lastMessageAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest        Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([reservationId])
  @@index([guestId])
  @@index([channel])
  @@index([status])
  @@index([externalId])
  @@index([lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  threadId       String
  senderUserId   String?
  channel        MessageChannel
  direction      MessageDirection @default(INBOUND)
  externalId     String?
  body           String
  bodyHtml       String?
  attachments    Json?
  sentAt         DateTime         @default(now())
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser   User?         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([threadId])
  @@index([channel])
  @@index([direction])
  @@index([externalId])
  @@index([sentAt])
  @@index([senderUserId])
}

// ─── Reports & Settings ──────────────────────────────────────────────────────

model ReportSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  reportKey      String
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  metrics        Json
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reportKey, periodStart, periodEnd])
  @@index([organizationId])
  @@index([reportKey])
  @@index([periodStart, periodEnd])
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // General
  defaultCheckInTime  String @default("16:00")
  defaultCheckOutTime String @default("11:00")
  defaultCurrency     String @default("EUR")
  defaultLocale       String @default("fr")
  defaultTimezone     String @default("Europe/Paris")
  // Billing / tax
  invoicePrefix       String?
  nextInvoiceNumber   Int     @default(1)
  vatRate             Decimal? @db.Decimal(5, 2)
  // Notifications
  notifyEmail         Boolean @default(true)
  notifySms           Boolean @default(false)
  // Feature flags & misc
  features            Json?
  branding            Json?
  integrations        Json?
  customFields        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Alias-friendly Setting model for org-scoped key/value overrides
model Setting {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PricingRule {
  id             String          @id @default(cuid())
  organizationId String
  propertyId     String?
  type           PricingRuleType
  name           String
  description    String?
  // Value semantics depend on type (amount, %, nights, etc.)
  amount         Decimal?        @db.Decimal(12, 2)
  percent        Decimal?        @db.Decimal(7, 4)
  minNights      Int?
  maxNights      Int?
  // Applicability window
  startDate      DateTime?       @db.Date
  endDate        DateTime?       @db.Date
  daysOfWeek     Int[]           @default([])
  priority       Int             @default(0)
  isActive       Boolean         @default(true)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([type])
  @@index([startDate, endDate])
  @@index([isActive])
  @@index([organizationId, propertyId, type])
}

// ─── Automations ─────────────────────────────────────────────────────────────

model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  trigger        AutomationTrigger
  conditions     Json?
  actions        Json
  isActive       Boolean           @default(true)
  priority       Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([trigger])
  @@index([isActive])
}

model AutomationRun {
  id             String              @id @default(cuid())
  organizationId String
  ruleId         String
  status         AutomationRunStatus @default(PENDING)
  triggerPayload Json?
  result         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ruleId])
  @@index([status])
  @@index([createdAt])
}

// ─── Channel Manager ─────────────────────────────────────────────────────────

model ChannelConnection {
  id               String                  @id @default(cuid())
  organizationId   String
  provider         ChannelProvider
  status           ChannelConnectionStatus @default(PENDING)
  accountName      String?
  // Encrypted credentials blob (never store plaintext secrets)
  credentialsEnc   Json?
  credentialsKeyId String?
  metadata         Json?
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings     ChannelListing[]
  mappings     PropertyChannelMapping[]
  webhookEvents WebhookEvent[]

  @@unique([organizationId, provider, accountName])
  @@index([organizationId])
  @@index([provider])
  @@index([status])
}

model ChannelListing {
  id             String          @id @default(cuid())
  organizationId String
  connectionId   String
  propertyId     String?
  provider       ChannelProvider
  externalId     String
  externalUrl    String?
  title          String?
  status         String?
  syncEnabled    Boolean         @default(true)
  lastSyncAt     DateTime?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  property     Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([propertyId])
  @@index([provider])
  @@index([externalId])
}

model PropertyChannelMapping {
  id             String          @id @default(cuid())
  organizationId String
  propertyId     String
  connectionId   String
  provider       ChannelProvider
  externalListingId String
  isPrimary      Boolean         @default(false)
  syncCalendar   Boolean         @default(true)
  syncPricing    Boolean         @default(true)
  syncContent    Boolean         @default(true)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([propertyId, connectionId, externalListingId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([connectionId])
  @@index([provider])
  @@index([externalListingId])
}

// ─── Webhooks, AI, Audit ─────────────────────────────────────────────────────

model WebhookEvent {
  id             String             @id @default(cuid())
  organizationId String?
  connectionId   String?
  provider       ChannelProvider?
  eventType      String
  externalId     String?
  status         WebhookEventStatus @default(RECEIVED)
  payload        Json
  headers        Json?
  error          String?
  processedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  connection   ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([connectionId])
  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([externalId])
  @@index([createdAt])
}

model AiJob {
  id             String      @id @default(cuid())
  organizationId String?
  userId         String?
  type           AiJobType
  status         AiJobStatus @default(QUEUED)
  input          Json?
  output         Json?
  error          String?
  model          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
