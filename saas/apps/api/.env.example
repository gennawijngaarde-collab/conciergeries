# Database
DATABASE_URL="postgresql://pms:pms@localhost:5432/pms?schema=public"

# Redis (queues / cache)
REDIS_URL="redis://localhost:6379"

# Supabase Auth
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App JWT / session (API-issued tokens if used alongside Supabase)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption for ChannelConnection.credentialsEnc
CREDENTIALS_ENCRYPTION_KEY="32-byte-base64-or-hex-key"

# App
NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
ALLOW_DEV_AUTH=true
# true = run Phase 1 without Docker/Postgres (in-memory demo data)
USE_MEMORY_STORE=true
