# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-here

# Microsoft Entra ID (Azure AD) - Optional for real integration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Microsoft 365 - Optional for real integration
M365_ADMIN_EMAIL=admin@your-tenant.onmicrosoft.com

# Lucca HRIS - Optional for real integration
LUCCA_API_URL=https://your-tenant.ilucca.net/api/v3
LUCCA_API_KEY=your-lucca-api-key

# Google Workspace - Optional for real integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=your-service-account-private-key
GOOGLE_DELEGATED_ADMIN=admin@your-domain.com
GOOGLE_CUSTOMER_ID=C01234567

# Okta - Optional for real integration
OKTA_DOMAIN=your-tenant.okta.com
OKTA_API_TOKEN=your-okta-api-token
