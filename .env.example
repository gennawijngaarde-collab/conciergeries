# =============================================================================
# Annuaire Conciergeries — variables d'environnement
# =============================================================================
# 1) Copie ce fichier :  cp .env.example .env.local
# 2) Remplis les valeurs (Supabase + Stripe + emails)
# 3) Sur Vercel : Project → Settings → Environment Variables
#    (mêmes noms, Production + Preview)
# 4) Redeploy après chaque changement de variables
#
# Ne committe JAMAIS .env / .env.local (secrets).
# =============================================================================

# --- Front Vite (exposées au navigateur — préfixe VITE_ obligatoire) ---------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnel — Maps (si tu actives Google Maps côté front)
# VITE_GOOGLE_MAPS_API_KEY=

# --- Supabase côté API Vercel (serverless /api/stripe/*) --------------------
# Tu peux dupliquer les valeurs VITE_ ou utiliser les noms serveur.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe (abonnements partenaire / Premium / PMS) ------------------------
STRIPE_SECRET_KEY=sk_test_...
# En production : sk_live_...

# Webhook Stripe → https://TON_DOMAINE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs Stripe (Dashboard → Products → Price ID)
STRIPE_STANDARD_PRICE=price_...
STRIPE_PREMIUM_PRICE=price_...
STRIPE_PMS_PRICE=price_...

# Alias acceptés par le code (optionnel, un seul jeu suffit) :
# STRIPE_PRICE_STANDARD=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_PMS=price_...

# --- App / URLs --------------------------------------------------------------
# URL publique du site (sans slash final)
PUBLIC_BASE_URL=https://ma-conciergerie-annuaire.com
# En local : PUBLIC_BASE_URL=http://localhost:5173

# --- Emails (webhook Stripe / notifications admin) --------------------------
RESEND_API_KEY=re_...
ADMIN_NOTIFY_EMAIL=toi@exemple.com

# =============================================================================
# Checklist Vercel (à coller telles quelles)
# =============================================================================
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY
# SUPABASE_URL                 (ou réutilise VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY            (ou réutilise VITE_SUPABASE_ANON_KEY)
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_STANDARD_PRICE
# STRIPE_PREMIUM_PRICE
# STRIPE_PMS_PRICE
# PUBLIC_BASE_URL
# RESEND_API_KEY
# ADMIN_NOTIFY_EMAIL
#
# Webhook Stripe (prod) :
#   https://ma-conciergerie-annuaire.com/api/stripe/webhook
# Events : checkout.session.completed, customer.subscription.*, invoice.*
# =============================================================================

# =============================================================================
# SaaS PMS (dossier saas/) — projet séparé, voir aussi :
#   saas/apps/api/.env.example
#   saas/apps/web/.env.example
# =============================================================================
# DATABASE_URL=
# REDIS_URL=
# USE_MEMORY_STORE=true
# ALLOW_DEV_AUTH=true
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# SUPABASE_JWT_SECRET=
# VITE_API_URL=http://localhost:3001
# VITE_DEV_ORG_ID=org_demo
